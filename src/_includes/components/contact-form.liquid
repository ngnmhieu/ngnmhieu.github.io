    <div class="xl:col-span-2">
      <label for="first-name" class="block text-sm/6 font-semibold text-gray-800 dark:text-white">Name*</label>
      <div class="mt-1">
        <input id="name" type="text" name="name" autocomplete="name" class="block w-full rounded-md bg-white px-3.5 py-2 text-base text-gray-800 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-gray-800 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-gray-500 dark:focus:outline-indigo-500" required />
      </div>
    </div>
    <div class="">
      <label for="email" class="block text-sm/6 font-semibold text-gray-800 dark:text-white">E-Mail*</label>
      <div class="mt-1">
        <input id="email" type="email" name="email" autocomplete="email" required class="block w-full rounded-md bg-white px-3.5 py-2 text-base text-gray-800 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-gray-800 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-gray-500 dark:focus:outline-indigo-500" />
      </div>
    </div>

    <div class="">
      <label for="phone" class="block text-sm/6 font-semibold text-gray-800 dark:text-white" required>Telefon</label>
      <div class="mt-1">
        <input id="phone" type="phone" name="phone" autocomplete="phone" class="block w-full rounded-md bg-white px-3.5 py-2 text-base text-gray-800 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-gray-800 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-gray-500 dark:focus:outline-indigo-500" />
      </div>
    </div>

    <div class="xl:col-span-2">
      <label for="message" class="block text-sm/6 font-semibold text-gray-800 dark:text-white">Nachricht*</label>
      <div class="mt-1">
        <textarea id="message" name="message" required rows="3" class="block w-full rounded-md bg-white px-3.5 py-2 text-base text-gray-800 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-gray-800 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-gray-500 dark:focus:outline-indigo-500"></textarea>
